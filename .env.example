# ---------------------------------------------------------------------------
# All of these are optional. With an empty .env the site still builds, indexes,
# and searches using local hashed embeddings + the committed vectors file.
# Copy to .env.local and fill in what you have.
# ---------------------------------------------------------------------------

# Public canonical origin. Used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="https://bookmarks.seangeng.com"

# --- Embeddings ------------------------------------------------------------
# With a key set, `npm run index` and query-time search use real semantic
# embeddings. Without it, both sides fall back to deterministic local vectors.
# OPENAI_API_KEY="sk-..."
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Any OpenAI-compatible endpoint works (Together, Groq, Ollama, ...).
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Chat model used for LLM topic classification during indexing.
# OPENAI_CHAT_MODEL="gpt-4o-mini"
# Force a provider instead of auto-detecting: openai | local
# EMBEDDING_PROVIDER="local"

# --- Vector store ----------------------------------------------------------
# Set both to push the index to Upstash Vector and query it at request time.
# Create the index with the dimension of your embedding model
# (1536 for text-embedding-3-small, 512 for the local provider).
# UPSTASH_VECTOR_REST_URL="https://<name>.upstash.io"
# UPSTASH_VECTOR_REST_TOKEN="..."
# UPSTASH_VECTOR_NAMESPACE=""
# Force a store instead of auto-detecting: upstash | local
# VECTOR_STORE="local"

# --- Crawler ---------------------------------------------------------------
# CRAWL_CONCURRENCY="5"
# CRAWL_TIMEOUT_MS="10000"
